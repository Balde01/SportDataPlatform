@startuml
' ============================================================
' Diagram C - Governance / Audit
' Purpose:
' - trace sensitive administrative actions
' - ensure administrative accountability
' - bootstrap the initial root administrator
'
' Depends on Identity/Auth and Admin/Provisioning
' ============================================================

left to right direction

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' =========================
' MODEL
' =========================
package "model" {

  enum AdminAction {
    PROVISION_AGENT
    REISSUE_INVITE
    UPDATE_ROLES
    DISABLE_USER
    ENABLE_USER
    RESET_PASSWORD
  }

  class AdminAuditLog {
    - id: UUID
    - actorUserId: UUID
    - targetUserId: UUID
    - action: AdminAction
    - metadata: String
    - createdAt: Instant
  }
}

' =========================
' REPOSITORY
' =========================
package "repository" {

  interface AdminAuditLogRepository {
    + save(log: AdminAuditLog): void
  }
}

' =========================
' SERVICES
' =========================
package "service" {

  class AuditService {
    - auditRepo: AdminAuditLogRepository
    - clock: Clock

    + log(
        actorId: UUID,
        action: AdminAction,
        targetUserId: UUID,
        metadata: String
      ): void
  }

  class AdminBootstrapper {
    - userRepository: UserRepository
    - passwordHasher: PasswordHasher
    - clock: Clock

    - email: String
    - rawPassword: String

    + ensureRootAdminExists(): void
  }
}

' =========================
' DEPENDENCIES FROM AUTH
' =========================
package "dependencies (from Auth)" {

  interface Clock

  interface PasswordHasher

  interface UserRepository
}

' =========================
' RELATIONSHIPS
' =========================
AdminAuditLog --> AdminAction

AuditService ..> AdminAuditLogRepository
AuditService ..> AdminAuditLog
AuditService ..> AdminAction
AuditService ..> Clock

AdminBootstrapper ..> UserRepository
AdminBootstrapper ..> PasswordHasher
AdminBootstrapper ..> Clock

@enduml
